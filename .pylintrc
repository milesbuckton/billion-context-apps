[MESSAGES CONTROL]
# Scripts are installed and run standalone, so hyphenated file names and
# repeated helpers are intentional, and fail-open paths catch broadly on purpose.
disable=invalid-name,
        missing-function-docstring,
        broad-exception-caught,
        duplicate-code,
        too-many-branches,
        too-many-locals,
        too-many-return-statements,
        too-many-statements
